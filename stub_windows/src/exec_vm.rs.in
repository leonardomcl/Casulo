//! Template da VM gerada por build; opcodes, constantes e bytecode são injetados pelo packer.

use core::sync::atomic::{compiler_fence, Ordering};

// Parâmetros gerados por build.

const OP_MOV_IMM: u8 = 0x@@OP_MOV_IMM@@;
const OP_XOR_IMM: u8 = 0x@@OP_XOR_IMM@@;
const OP_ADD_IMM: u8 = 0x@@OP_ADD_IMM@@;
const OP_MUL_IMM: u8 = 0x@@OP_MUL_IMM@@;
const OP_ROL_IMM: u8 = 0x@@OP_ROL_IMM@@;
const OP_MIX_REG: u8 = 0x@@OP_MIX_REG@@;
const OP_CMP_IMM: u8 = 0x@@OP_CMP_IMM@@;
const OP_JNZ: u8 = 0x@@OP_JNZ@@;
const OP_HOST_CALL: u8 = 0x@@OP_HOST_CALL@@;
const OP_EMIT: u8 = 0x@@OP_EMIT@@;
const OP_HALT: u8 = 0x@@OP_HALT@@;

const SOP_LOAD_ENC: u8 = 0x@@SOP_LOAD_ENC@@;
const SOP_LOAD_MASK: u8 = 0x@@SOP_LOAD_MASK@@;
const SOP_LOAD_MIX: u8 = 0x@@SOP_LOAD_MIX@@;
const SOP_XOR_REG: u8 = 0x@@SOP_XOR_REG@@;
const SOP_STORE_OUT: u8 = 0x@@SOP_STORE_OUT@@;
const SOP_INC_INDEX: u8 = 0x@@SOP_INC_INDEX@@;
const SOP_CMP_INDEX: u8 = 0x@@SOP_CMP_INDEX@@;
const SOP_JNZ: u8 = 0x@@SOP_JNZ@@;
const SOP_HALT: u8 = 0x@@SOP_HALT@@;

// Capacidades do host expostas ao bytecode.

const HOST_VERIFY_GATE: u8 = 0x@@HOST_VERIFY_GATE@@;
const HOST_EXEC_PAYLOAD: u8 = 0x@@HOST_EXEC_PAYLOAD@@;

const PROG_KEY: u64 = 0x@@PROG_KEY@@;
const PROG_STRIDE: u64 = 0x@@PROG_STRIDE@@;
const PROG_MUL: u64 = 0x@@PROG_MUL@@;

const GATE_K1: u64 = 0x@@GATE_K1@@;
const GATE_K2: u64 = 0x@@GATE_K2@@;
const GATE_K3: u64 = 0x@@GATE_K3@@;
const GATE_R1: u32 = @@GATE_R1@@;
const GATE_R2: u32 = @@GATE_R2@@;

/// Zero indica gate validado, então o estado inicial precisa ser diferente de zero.

const GATE_INIT_DELTA: u64 = 0x@@GATE_INIT_DELTA@@;

const MIX_PROGRAM_LEN: usize = @@MIX_PROGRAM_LEN@@;
static MIX_PROGRAM_ENC: [u8; MIX_PROGRAM_LEN] = [@@MIX_PROGRAM@@];

const GATE_PROGRAM_LEN: usize = @@GATE_PROGRAM_LEN@@;
static GATE_PROGRAM_ENC: [u8; GATE_PROGRAM_LEN] = [@@GATE_PROGRAM@@];

const SECRET_PROGRAM_LEN: usize = @@SECRET_PROGRAM_LEN@@;
static SECRET_PROGRAM_ENC: [u8; SECRET_PROGRAM_LEN] = [@@SECRET_PROGRAM@@];

const REG_COUNT: usize = 4;
const MIX_SIZE: usize = 32;
const SECRET_SIZE: usize = 32;
const SECRET_REG_COUNT: usize = 2;

/// A limpeza usa blocos de 4 KiB para limitar o custo de dispatch da VM.

const ZERO_BLOCK_SIZE: usize = 4096;

/// Limita a execução e evita loop infinito em bytecode inválido.

const MAX_STEPS: usize = max_len() + 64;

const SECRET_MAX_STEPS: usize = SECRET_SIZE * 16 + 32;

const fn max_len() -> usize {
    let a = if MIX_PROGRAM_LEN > GATE_PROGRAM_LEN {
        MIX_PROGRAM_LEN
    } else {
        GATE_PROGRAM_LEN
    };
    if a > SECRET_PROGRAM_LEN { a } else { SECRET_PROGRAM_LEN }
}

#[inline(never)]
fn wipe_bytes(data: &mut [u8]) {
    for b in data {
        unsafe { core::ptr::write_volatile(b, 0) };
    }
    compiler_fence(Ordering::SeqCst);
}

#[inline(never)]
fn wipe_words(data: &mut [u64]) {
    for w in data {
        unsafe { core::ptr::write_volatile(w, 0) };
    }
    compiler_fence(Ordering::SeqCst);
}

#[inline(never)]
fn keystream_byte(index: usize) -> u8 {
    let mut x = PROG_KEY ^ (index as u64).wrapping_mul(PROG_STRIDE);
    x ^= x >> 33;
    x = x.wrapping_mul(PROG_MUL);
    x ^= x >> 29;
    (x & 0xFF) as u8
}

/// O bytecode decifrado é apagado ao sair de escopo.

struct Code<const N: usize> {
    buf: [u8; N],
}

impl<const N: usize> Code<N> {
    fn decrypt(enc: &[u8; N]) -> Self {
        let mut buf = [0u8; N];
        let mut i = 0usize;
        while i < N {
            buf[i] = enc[i] ^ keystream_byte(i);
            i += 1;
        }
        Self { buf }
    }
}

impl<const N: usize> Drop for Code<N> {
    fn drop(&mut self) {
        wipe_bytes(&mut self.buf);
    }
}

trait Host {
    fn call(&mut self, id: u8, regs: &mut [u64; REG_COUNT]) -> Result<(), ()>;
}

/// Programas com `NullHost` não podem chamar capacidades do host.

struct NullHost;

impl Host for NullHost {
    fn call(&mut self, _id: u8, _regs: &mut [u64; REG_COUNT]) -> Result<(), ()> {
        Err(())
    }
}

/// `delta == 0` somente quando o estado calculado bate com o gate esperado.

struct GateHost<F>
where
    F: FnOnce() -> i32,
{
    expected: u64,
    delta: u64,
    exec: Option<F>,
}

impl<F> Host for GateHost<F>
where
    F: FnOnce() -> i32,
{
    fn call(&mut self, id: u8, regs: &mut [u64; REG_COUNT]) -> Result<(), ()> {
        match id {
            HOST_VERIFY_GATE => {
                self.delta = regs[0] ^ self.expected;
                regs[0] = if self.delta == 0 { 1 } else { 0 };
                Ok(())
            }

            HOST_EXEC_PAYLOAD => {
                if self.delta != 0 {
                    return Err(());
                }

                // A transição do host só pode ser consumida uma vez.

                let exec = self.exec.take().ok_or(())?;
                let code = exec();
                regs[0] = code as i64 as u64;
                Ok(())
            }

            _ => Err(()),
        }
    }
}

impl<F> Drop for GateHost<F>
where
    F: FnOnce() -> i32,
{
    fn drop(&mut self) {
        unsafe {
            core::ptr::write_volatile(&mut self.expected, 0);
            core::ptr::write_volatile(&mut self.delta, GATE_INIT_DELTA);
        }
        compiler_fence(Ordering::SeqCst);
    }
}

struct Vm<'a, H>
where
    H: Host,
{
    code: &'a [u8],
    ip: usize,
    regs: [u64; REG_COUNT],
    /// Espelha o ZF; começa ativo para evitar JNZ acidental antes de CMP.

    zero: bool,
    out: [u8; MIX_SIZE],
    emitted: bool,
    host: H,
}

impl<'a, H> Drop for Vm<'a, H>
where
    H: Host,
{
    fn drop(&mut self) {
        wipe_words(&mut self.regs);
        wipe_bytes(&mut self.out);
    }
}

impl<'a, H> Vm<'a, H>
where
    H: Host,
{
    fn new(code: &'a [u8], host: H) -> Self {
        Self {
            code,
            ip: 0,
            regs: [0u64; REG_COUNT],
            zero: true,
            out: [0u8; MIX_SIZE],
            emitted: false,
            host,
        }
    }

    #[inline]
    fn read_u8(&mut self) -> Result<u8, ()> {
        let v = *self.code.get(self.ip).ok_or(())?;
        self.ip = self.ip.checked_add(1).ok_or(())?;
        Ok(v)
    }

    #[inline]
    fn read_u16(&mut self) -> Result<u16, ()> {
        let b0 = self.read_u8()?;
        let b1 = self.read_u8()?;
        Ok(u16::from_le_bytes([b0, b1]))
    }

    #[inline]
    fn read_u64(&mut self) -> Result<u64, ()> {
        let end = self.ip.checked_add(8).ok_or(())?;
        let s = self.code.get(self.ip..end).ok_or(())?;
        let mut b = [0u8; 8];
        b.copy_from_slice(s);
        self.ip = end;
        Ok(u64::from_le_bytes(b))
    }

    #[inline]
    fn reg_index(&mut self) -> Result<usize, ()> {
        let r = self.read_u8()? as usize;
        if r >= REG_COUNT {
            return Err(());
        }
        Ok(r)
    }

    /// Rotações válidas ficam em 1..=63.

    #[inline]
    fn rot_amount(&mut self) -> Result<u32, ()> {
        let bits = self.read_u8()? as u32;
        if bits == 0 || bits >= 64 {
            return Err(());
        }
        Ok(bits)
    }

    fn run(&mut self) -> Result<i32, ()> {
        let mut steps = 0usize;

        loop {
            steps = steps.checked_add(1).ok_or(())?;
            if steps > MAX_STEPS {
                return Err(());
            }

            let op = self.read_u8()?;

            match op {
                OP_MOV_IMM => {
                    let r = self.reg_index()?;
                    self.regs[r] = self.read_u64()?;
                }

                OP_XOR_IMM => {
                    let r = self.reg_index()?;
                    let imm = self.read_u64()?;
                    self.regs[r] ^= imm;
                }

                OP_ADD_IMM => {
                    let r = self.reg_index()?;
                    let imm = self.read_u64()?;
                    self.regs[r] = self.regs[r].wrapping_add(imm);
                }

                OP_MUL_IMM => {
                    let r = self.reg_index()?;
                    let imm = self.read_u64()?;
                    // Multiplicação por ímpar é bijetiva em 2^64.

                    if imm & 1 == 0 {
                        return Err(());
                    }
                    self.regs[r] = self.regs[r].wrapping_mul(imm);
                }

                OP_ROL_IMM => {
                    let r = self.reg_index()?;
                    let bits = self.rot_amount()?;
                    self.regs[r] = self.regs[r].rotate_left(bits);
                }

                OP_MIX_REG => {
                    let dst = self.reg_index()?;
                    let src = self.reg_index()?;
                    let bits = self.rot_amount()?;
                    self.regs[dst] ^= self.regs[src].rotate_left(bits);
                }

                OP_CMP_IMM => {
                    let r = self.reg_index()?;
                    let imm = self.read_u64()?;
                    self.zero = self.regs[r] == imm;
                }

                OP_JNZ => {
                    let target = self.read_u16()? as usize;
                    if !self.zero {
                        if target >= self.code.len() {
                            return Err(());
                        }
                        self.ip = target;
                    }
                }

                OP_HOST_CALL => {
                    let id = self.read_u8()?;
                    self.host.call(id, &mut self.regs)?;
                }

                OP_EMIT => {
                    if self.emitted {
                        return Err(());
                    }
                    let mut i = 0usize;
                    while i < REG_COUNT {
                        let b = self.regs[i].to_le_bytes();
                        self.out[i * 8..i * 8 + 8].copy_from_slice(&b);
                        i += 1;
                    }
                    self.emitted = true;
                }

                OP_HALT => return Ok(self.regs[0] as i32),

                _ => return Err(()),
            }
        }
    }
}

struct SecretVm<'a> {
    code: &'a [u8],
    ip: usize,
    regs: [u8; SECRET_REG_COUNT],
    index: usize,
    zero: bool,
    enc: &'a [u8; SECRET_SIZE],
    mask: &'a [u8; SECRET_SIZE],
    mix: &'a [u8; SECRET_SIZE],
    output: [u8; SECRET_SIZE],
}

impl<'a> Drop for SecretVm<'a> {
    fn drop(&mut self) {
        wipe_bytes(&mut self.output);
        wipe_bytes(&mut self.regs);
    }
}

impl<'a> SecretVm<'a> {
    fn new(
        code: &'a [u8],
        enc: &'a [u8; SECRET_SIZE],
        mask: &'a [u8; SECRET_SIZE],
        mix: &'a [u8; SECRET_SIZE],
    ) -> Self {
        Self {
            code,
            ip: 0,
            regs: [0u8; SECRET_REG_COUNT],
            index: 0,
            zero: true,
            enc,
            mask,
            mix,
            output: [0u8; SECRET_SIZE],
        }
    }

    #[inline]
    fn read_u8(&mut self) -> Result<u8, ()> {
        let v = *self.code.get(self.ip).ok_or(())?;
        self.ip = self.ip.checked_add(1).ok_or(())?;
        Ok(v)
    }

    #[inline]
    fn read_u16(&mut self) -> Result<u16, ()> {
        let b0 = self.read_u8()?;
        let b1 = self.read_u8()?;
        Ok(u16::from_le_bytes([b0, b1]))
    }

    #[inline]
    fn reg_index(&mut self) -> Result<usize, ()> {
        let r = self.read_u8()? as usize;
        if r >= SECRET_REG_COUNT {
            return Err(());
        }
        Ok(r)
    }

    #[inline]
    fn current_index(&self) -> Result<usize, ()> {
        if self.index >= SECRET_SIZE {
            return Err(());
        }
        Ok(self.index)
    }

    /// Escreve direto no buffer do chamador para evitar cópias extras do Secret.

    fn run(&mut self, out: &mut [u8; SECRET_SIZE]) -> Result<(), ()> {
        let mut steps = 0usize;

        loop {
            steps = steps.checked_add(1).ok_or(())?;
            if steps > SECRET_MAX_STEPS {
                return Err(());
            }

            let op = self.read_u8()?;

            match op {
                SOP_LOAD_ENC => {
                    let r = self.reg_index()?;
                    let i = self.current_index()?;
                    self.regs[r] = self.enc[i];
                }

                SOP_LOAD_MASK => {
                    let r = self.reg_index()?;
                    let i = self.current_index()?;
                    self.regs[r] = self.mask[i];
                }

                SOP_LOAD_MIX => {
                    let r = self.reg_index()?;
                    let i = self.current_index()?;
                    self.regs[r] = self.mix[i];
                }

                SOP_XOR_REG => {
                    let dst = self.reg_index()?;
                    let src = self.reg_index()?;
                    let rhs = self.regs[src];
                    self.regs[dst] ^= rhs;
                }

                SOP_STORE_OUT => {
                    let r = self.reg_index()?;
                    let i = self.current_index()?;
                    self.output[i] = self.regs[r];
                }

                SOP_INC_INDEX => {
                    self.index = self.index.checked_add(1).ok_or(())?;
                    if self.index > SECRET_SIZE {
                        return Err(());
                    }
                }

                SOP_CMP_INDEX => {
                    let expected = self.read_u8()? as usize;
                    self.zero = self.index == expected;
                }

                SOP_JNZ => {
                    let target = self.read_u16()? as usize;
                    if !self.zero {
                        if target >= self.code.len() {
                            return Err(());
                        }
                        self.ip = target;
                    }
                }

                SOP_HALT => {
                    if self.index != SECRET_SIZE {
                        return Err(());
                    }
                    out.copy_from_slice(&self.output);
                    return Ok(());
                }

                _ => return Err(()),
            }
        }
    }
}

const ZOP_ZERO_BLOCK: u8 = SOP_STORE_OUT;
const ZOP_ADVANCE: u8 = SOP_INC_INDEX;
const ZOP_CMP_END: u8 = SOP_CMP_INDEX;
const ZOP_JNZ: u8 = SOP_JNZ;
const ZOP_HALT: u8 = SOP_HALT;

/// Programa fixo de limpeza; o salto nunca sai do próprio bytecode.

const ZERO_PROGRAM: [u8; 7] = [
    ZOP_ZERO_BLOCK,
    ZOP_ADVANCE,
    ZOP_CMP_END,
    ZOP_JNZ,
    0,
    0,
    ZOP_HALT,
];

struct ZeroVm<'a> {
    code: &'a [u8],
    ip: usize,
    index: usize,
    zero: bool,
    data: &'a mut [u8],
}

impl<'a> ZeroVm<'a> {
    fn new(code: &'a [u8], data: &'a mut [u8]) -> Self {
        Self {
            code,
            ip: 0,
            index: 0,
            zero: data.is_empty(),
            data,
        }
    }

    #[inline]
    fn read_u8(&mut self) -> Result<u8, ()> {
        let v = *self.code.get(self.ip).ok_or(())?;
        self.ip = self.ip.checked_add(1).ok_or(())?;
        Ok(v)
    }

    #[inline]
    fn read_u16(&mut self) -> Result<u16, ()> {
        let b0 = self.read_u8()?;
        let b1 = self.read_u8()?;
        Ok(u16::from_le_bytes([b0, b1]))
    }

    #[inline]
    fn block_end(&self) -> Result<usize, ()> {
        if self.index > self.data.len() {
            return Err(());
        }

        let wanted = self.index.checked_add(ZERO_BLOCK_SIZE).ok_or(())?;
        Ok(wanted.min(self.data.len()))
    }

    fn run(&mut self) -> Result<(), ()> {
        if self.data.is_empty() {
            return Ok(());
        }

        let blocks = self
            .data
            .len()
            .checked_add(ZERO_BLOCK_SIZE - 1)
            .ok_or(())?
            / ZERO_BLOCK_SIZE;
        let max_steps = blocks.checked_mul(4).and_then(|v| v.checked_add(8)).ok_or(())?;
        let mut steps = 0usize;

        loop {
            steps = steps.checked_add(1).ok_or(())?;
            if steps > max_steps {
                return Err(());
            }

            let op = self.read_u8()?;

            match op {
                ZOP_ZERO_BLOCK => {
                    let end = self.block_end()?;
                    let start = self.index;
                    if start >= end {
                        return Err(());
                    }

                // O bytecode não fornece ponteiros nativos.

                    let ptr = self.data.as_mut_ptr();
                    let mut i = start;
                    while i < end {
                        unsafe { core::ptr::write_volatile(ptr.add(i), 0) };
                        i += 1;
                    }
                    compiler_fence(Ordering::SeqCst);
                }

                ZOP_ADVANCE => {
                    self.index = self.block_end()?;
                }

                ZOP_CMP_END => {
                    self.zero = self.index == self.data.len();
                }

                ZOP_JNZ => {
                    let target = self.read_u16()? as usize;
                    if !self.zero {
                        if target >= self.code.len() {
                            return Err(());
                        }
                        self.ip = target;
                    }
                }

                ZOP_HALT => {
                    if self.index != self.data.len() || !self.zero {
                        return Err(());
                    }
                    return Ok(());
                }

                _ => return Err(()),
            }
        }
    }
}

/// Executa a ZeroVm e usa limpeza volátil como fallback em caso de erro.

#[inline(never)]
pub fn vm_secure_zero(data: &mut [u8]) -> Result<(), ()> {
    if data.is_empty() {
        return Ok(());
    }

    let result = {
        let mut vm = ZeroVm::new(&ZERO_PROGRAM, data);
        vm.run()
    };

    if result.is_err() {
        wipe_bytes(data);
    }

    result
}

/// Executa o programa de mistura gerado para este build.

#[inline(never)]
pub fn derive_mix(seed: &[u8; MIX_SIZE], out: &mut [u8; MIX_SIZE]) -> Result<(), ()> {
    let code = Code::<MIX_PROGRAM_LEN>::decrypt(&MIX_PROGRAM_ENC);
    let mut vm = Vm::new(&code.buf, NullHost);

    let mut i = 0usize;
    while i < REG_COUNT {
        let mut b = [0u8; 8];
        b.copy_from_slice(&seed[i * 8..i * 8 + 8]);
        vm.regs[i] = u64::from_le_bytes(b);
        i += 1;
    }

    vm.run()?;
    if !vm.emitted {
        return Err(());
    }

    out.copy_from_slice(&vm.out);
    Ok(())
}

/// Reconstrói o Secret usando apenas os buffers visíveis à VM.

#[inline(never)]
pub fn decode_secret(
    enc: &[u8; SECRET_SIZE],
    mask: &[u8; SECRET_SIZE],
    mix: &[u8; SECRET_SIZE],
    out: &mut [u8; SECRET_SIZE],
) -> Result<(), ()> {
    let code = Code::<SECRET_PROGRAM_LEN>::decrypt(&SECRET_PROGRAM_ENC);
    let mut vm = SecretVm::new(&code.buf, enc, mask, mix);
    vm.run(out)
}

#[inline(never)]
fn gate_state(token: u64) -> u64 {
    ((token ^ GATE_K1)
        .rotate_left(GATE_R1)
        .wrapping_add(GATE_K2)
        ^ GATE_K3)
        .rotate_left(GATE_R2)
}

/// Faz a transição final pela tabela restrita de capacidades do host.

pub fn execute<F>(token: u64, host_exec: F) -> Result<i32, ()>
where
    F: FnOnce() -> i32,
{
    let code = Code::<GATE_PROGRAM_LEN>::decrypt(&GATE_PROGRAM_ENC);
    let host = GateHost {
        expected: gate_state(token),
        delta: GATE_INIT_DELTA,
        exec: Some(host_exec),
    };

    let mut vm = Vm::new(&code.buf, host);
    vm.regs[0] = token;
    vm.run()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn gate_program_executes_host_once() {
        let mut calls = 0usize;
        let r = execute(0x1122_3344_5566_7788, || {
            calls += 1;
            37
        });

        assert_eq!(r, Ok(37));
        assert_eq!(calls, 1);
    }

    #[test]
    fn arbitrary_host_id_is_rejected() {
        let code = [OP_HOST_CALL, 0xFE, OP_HALT];
        let host = GateHost {
            expected: 0,
            delta: GATE_INIT_DELTA,
            exec: Some(|| 0),
        };
        let mut vm = Vm::new(&code, host);
        assert_eq!(vm.run(), Err(()));
    }

    #[test]
    fn exec_capability_requires_verified_gate() {
        let code = [OP_HOST_CALL, HOST_EXEC_PAYLOAD, OP_HALT];
        let host = GateHost {
            expected: 0x5678,
            delta: GATE_INIT_DELTA,
            exec: Some(|| 0),
        };
        let mut vm = Vm::new(&code, host);
        assert_eq!(vm.run(), Err(()));
    }

    #[test]
    fn mix_is_deterministic_and_seed_sensitive() {
        let mut seed = [0u8; MIX_SIZE];
        for i in 0..MIX_SIZE {
            seed[i] = (i as u8).wrapping_mul(31).wrapping_add(7);
        }

        let mut a = [0u8; MIX_SIZE];
        let mut b = [0u8; MIX_SIZE];
        assert_eq!(derive_mix(&seed, &mut a), Ok(()));
        assert_eq!(derive_mix(&seed, &mut b), Ok(()));
        assert_eq!(a, b);

        seed[0] ^= 1;
        let mut c = [0u8; MIX_SIZE];
        assert_eq!(derive_mix(&seed, &mut c), Ok(()));
        assert_ne!(a, c);
    }

    #[test]
    fn secret_vm_reconstructs_32_bytes() {
        let mut enc = [0u8; SECRET_SIZE];
        let mut mask = [0u8; SECRET_SIZE];
        let mut mix = [0u8; SECRET_SIZE];
        let mut expected = [0u8; SECRET_SIZE];

        for i in 0..SECRET_SIZE {
            expected[i] = (i as u8).wrapping_mul(7).wrapping_add(3);
            mask[i] = (i as u8).wrapping_mul(11).wrapping_add(0x5A);
            mix[i] = (i as u8).wrapping_mul(19).wrapping_add(0xC3);
            enc[i] = expected[i] ^ mask[i] ^ mix[i];
        }

        let mut out = [0u8; SECRET_SIZE];
        assert_eq!(decode_secret(&enc, &mask, &mix, &mut out), Ok(()));
        assert_eq!(out, expected);
    }

    #[test]
    fn zero_vm_wipes_small_and_large_buffers() {
        let mut small = [0xA5u8; 31];
        assert_eq!(vm_secure_zero(&mut small), Ok(()));
        assert!(small.iter().all(|&b| b == 0));

        let mut large = vec![0x5Au8; ZERO_BLOCK_SIZE * 2 + 123];
        assert_eq!(vm_secure_zero(&mut large), Ok(()));
        assert!(large.iter().all(|&b| b == 0));
    }

    #[test]
    fn wrong_mix_yields_wrong_secret() {
        let enc = [0x11u8; SECRET_SIZE];
        let mask = [0x22u8; SECRET_SIZE];
        let mut mix = [0x33u8; SECRET_SIZE];

        let mut a = [0u8; SECRET_SIZE];
        assert_eq!(decode_secret(&enc, &mask, &mix, &mut a), Ok(()));

        mix[5] ^= 0x80;
        let mut b = [0u8; SECRET_SIZE];
        assert_eq!(decode_secret(&enc, &mask, &mix, &mut b), Ok(()));
        assert_ne!(a, b);
    }
}
